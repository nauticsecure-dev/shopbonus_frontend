{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "next.config.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-homepage-cms/types/**/*.ts",
    ".next-homepage-cms/dev/types/**/*.ts",
    ".next-about-cms/types/**/*.ts",
    ".next-about-cms/dev/types/**/*.ts",
    ".next-homepage-live/types/**/*.ts",
    ".next-homepage-live/dev/types/**/*.ts",
    ".next-homepage-live-webpack/types/**/*.ts",
    ".next-homepage-live-webpack/dev/types/**/*.ts",
    ".next-affiliate-review/types/**/*.ts",
    ".next-affiliate-review/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
