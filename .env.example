# Public browser config only — never put Laravel APP_KEY, DB passwords, or API secrets here.

# Next.js app origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Laravel API origin (must match CORS_ALLOWED_ORIGINS / FRONTEND_URL on the backend)
# Local ShopBonus artisan serve uses 8010 — not another project's :8000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8010

# Sanctum SPA cookie auth (credentials + CSRF). Set false only for pure token demos.
NEXT_PUBLIC_USE_COOKIE_AUTH=true

# Optional Laravel Reverb (public key only). Omit to rely on HTTP wallet refresh.
# NEXT_PUBLIC_REVERB_APP_KEY=
# NEXT_PUBLIC_REVERB_HOST=127.0.0.1
# NEXT_PUBLIC_REVERB_PORT=8080
# NEXT_PUBLIC_REVERB_SCHEME=http

# Optional Postgres for /api/health (omit = health returns 503)
# DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/shopbonus
